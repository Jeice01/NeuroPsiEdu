# NeuroPsiEdu frontend environment
#
# Copy this file to .env.local and replace placeholders with values from:
# Supabase Dashboard > Project Settings > API Keys.
#
# Variables prefixed with NEXT_PUBLIC_ are included in the browser bundle.
# Never place a service_role or sb_secret_* key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The code currently uses the legacy variable name below. It may contain either
# a publishable key (preferred) or a legacy anon key. Access must be protected
# by grants and Row Level Security; this is not an authorization secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public Cloudflare Turnstile site key. This value is safe for the browser.
# Create the widget for neuropsiedu.com.br and www.neuropsiedu.com.br.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Courses are isolated from institutional leads. Leave disabled until backend,
# SMTP/OTP, approved legal documents and release checks have been verified.
NEXT_PUBLIC_CURSOS_ENABLED=false
# Separate interest list. Enable only after the interest endpoint is deployed.
NEXT_PUBLIC_CURSOS_INTERESSE_ENABLED=false
# Build an informational Zulliger page with registration and test checkout hidden.
ZULLIGER_INFORMATION_ONLY=false
NEXT_PUBLIC_CURSOS_CHECKOUT_SANDBOX_ENABLED=false
NEXT_PUBLIC_CURSOS_FUNCTION_URL=https://ydmvbssgiffqrmwigkae.supabase.co/functions/v1/cadastro-curso
NEXT_PUBLIC_CURSOS_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CURSOS_TERMS_VERSION=
NEXT_PUBLIC_CURSOS_PRIVACY_VERSION=
NEXT_PUBLIC_CURSOS_TERMS_URL=
NEXT_PUBLIC_CURSOS_PRIVACY_URL=
