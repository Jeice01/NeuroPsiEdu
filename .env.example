# NeuroPsiEdu frontend environment
#
# Copy this file to .env.local and replace placeholders with values from:
# Supabase Dashboard > Project Settings > API Keys.
#
# Variables prefixed with NEXT_PUBLIC_ are included in the browser bundle.
# Never place a service_role or sb_secret_* key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The code currently uses the legacy variable name below. It may contain either
# a publishable key (preferred) or a legacy anon key. Access must be protected
# by grants and Row Level Security; this is not an authorization secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public Cloudflare Turnstile site key. This value is safe for the browser.
# Create the widget for neuropsiedu.com.br and www.neuropsiedu.com.br.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
