# NeuroPsiEdu Supabase Edge Function environment
#
# These variables are supplied automatically to deployed Supabase Edge
# Functions. This file exists only as a safe reference for local development.
# Never commit real values and never expose either value through NEXT_PUBLIC_*.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY

# Cloudflare Turnstile. Keep the secret only in Supabase Edge Function secrets.
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
TURNSTILE_EXPECTED_ACTION=lead_formacao
TURNSTILE_ALLOWED_HOSTNAMES=neuropsiedu.com.br,www.neuropsiedu.com.br

# Random secret with at least 32 bytes, used as the HMAC key for rate-limit
# identifiers. Generate a unique production value; never reuse an API key.
RATE_LIMIT_SALT=YOUR_RANDOM_32_BYTE_OR_LONGER_SECRET

# Optional extra origins for local testing. Do not add wildcard or preview
# domains in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
